# LLM API configuration (supports any LLM API in OpenAI SDK format)
# Recommended: Alibaba Bailian platform qwen-plus model: https://bailian.console.aliyun.com/
# Note: resource consumption can be high; try simulations with fewer than 40 rounds first
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== PostgreSQL database configuration =====
DATABASE_URL=postgresql://mirofish:mirofish_secret@localhost:5432/mirofish

# ===== Accelerated LLM configuration (optional) =====
# Note: if you do not use the accelerated configuration, do not include the settings below in the env file
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
